<?xml version="1.0" encoding="utf-8"?>
<!--
    Archivo placeholder para la familia tipográfica OpenDyslexic.

    Para que funcione, necesitás descargar los archivos .ttf de OpenDyslexic
    y colocarlos en esta misma carpeta (app/src/main/res/font/):

      - open_dyslexic_regular.ttf
      - open_dyslexic_bold.ttf
      - open_dyslexic_italic.ttf   (opcional)
      - open_dyslexic_bold_italic.ttf (opcional)

    Descarga: https://opendyslexic.org/

    Una vez colocados los .ttf, este XML los unifica como familia tipográfica.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/open_dyslexic_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/open_dyslexic_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/open_dyslexic_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/open_dyslexic_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

</font-family>
